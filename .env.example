# Copy to `.env` for local development. Never commit `.env`.

# PostgreSQL connection string for the application and Prisma CLI.
# On Railway, reference the PostgreSQL service's DATABASE_URL variable.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dora?schema=public"

# Separate PostgreSQL database for `npm run test:db` (migrated automatically; must differ
# from DATABASE_URL). Tests only remove records they created themselves.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dora_test?schema=public"

# HTTP port. Optional locally (defaults to 3000); Railway assigns it automatically.
# PORT=3000
