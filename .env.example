# Environment variables for DORA. Copy to `.env` for local development. Never commit `.env`.
# No AI/LLM API keys are needed — DORA is rule-based.

# ── Required ────────────────────────────────────────────────────────────────────────────────
# PostgreSQL connection string for the application and the Prisma CLI (migrations).
#   Local development:  your local PostgreSQL (see README).
#   Docker Compose:     set in compose.yaml (points at the bundled `db` container); not read from here.
#   Railway:            set on the DORA service as a reference to the PostgreSQL service,
#                       DATABASE_URL=${{Postgres.DATABASE_URL}}  (see RAILWAY_DEPLOYMENT.md).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dora?schema=public"

# ── Tests only ──────────────────────────────────────────────────────────────────────────────
# Separate PostgreSQL database for `npm run test:db` (migrated automatically; must differ
# from DATABASE_URL). Tests only remove records they created themselves.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dora_test?schema=public"

# ── Optional ────────────────────────────────────────────────────────────────────────────────
# HTTP port. Defaults to 3000. Railway injects PORT automatically — do not set it there.
# PORT=3000

# Docker image only: set to "false" to skip `prisma migrate deploy` at container start
# (e.g. when migrations run as a separate pre-deploy step). Default: true.
# RUN_MIGRATIONS=true

# Local Docker Compose only: host ports (defaults 3000 and 5433).
# DORA_PORT=3000
# DORA_DB_PORT=5433
